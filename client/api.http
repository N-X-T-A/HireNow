### User APIs

#### Sign Up
POST http://localhost:5000/api/v1/auth/signup
Content-Type: application/json

{
  "username": "Tran Phuong Thai",
  "email": "user@example.com",
  "password": "password123"
}

#### Sign In
POST http://localhost:5000/api/v1/auth/signin
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "password123"
}

#### Sign Out
GET http://localhost:5000/api/v1/auth/signout

#### Google Sign-In
POST http://localhost:5000/api/v1/auth/google
Content-Type: application/json

{
  "accessToken": "token"
}

### User Profile

#### Update User Profile
POST http://localhost:5000/api/v1/user/update-profile
Authorization: Bearer ACCESS_TOKEN
Content-Type: application/json

{
  "username": "Nguyen Van A",
  "phone": "0987654321",
  "location": "Hanoi",
  "bio": "Software Engineer with 2 years of experience.",
  "photoURL": "https://example.com/avatar.jpg",
  "education": {
    "institution": "Hanoi University of Science and Technology",
    "degree": "Bachelor",
    "field_of_study": "Computer Science",
    "start_date": "2019-09-01",
    "end_date": "2023-06-01",
    "description": "Studied AI and Machine Learning."
  },
  "experience": {
    "company_name": "FPT Software",
    "position": "Software Engineer",
    "start_date": "2023-06-01",
    "end_date": "2024-02-01",
    "description": "Developed web applications using ReactJS."
  },
  "skills": ["65f7a1b3d1a2e3f4c5b6a701", "65f7a1b3d1a2e3f4c5b6a703"]
}

### Job Listings

#### Get Job Listings
GET http://localhost:5000/api/v1/job

#### Get Recommended Jobs
GET http://localhost:5000/api/v1/job/recommend
Authorization: Bearer ACCESS_TOKEN

#### Get Job Details
GET http://localhost:5000/api/v1/job/JOB_ID_HERE

### Job Applications

#### Apply for a Job
POST http://localhost:5000/api/v1/application
Authorization: Bearer USER_ACCESS_TOKEN
Content-Type: application/json

{
  "job_id": "65e0f5b93c8c3e12a4dfe217",
  "resume": "https://res.cloudinary.com/example/uploads/resumes/abc123.pdf",
  "cover_letter": "I am interested in this position."
}

#### Get List Applied Jobs
GET http://localhost:5000/api/v1/application
Authorization: Bearer USER_ACCESS_TOKEN

### Company

#### Get Company List
GET http://localhost:5000/api/v1/company/

#### Get Company Details
GET http://localhost:5000/api/v1/company/:id

### Favorite Jobs

#### Add Job to Favorites
POST http://localhost:5000/api/v1/favorite
Authorization: Bearer USER_ACCESS_TOKEN

{
  "jobId": "67c1e258ba3d3e783ee64a91"
}

#### Get Favorite Jobs
GET http://localhost:5000/api/v1/favorite
Authorization: Bearer USER_ACCESS_TOKEN

#### Remove Job from Favorites
DELETE http://localhost:5000/api/v1/favorite/ID
Authorization: Bearer USER_ACCESS_TOKEN

### Uploads

#### Upload Image
POST http://localhost:5000/api/v1/upload/image
Content-Type: multipart/form-data

#### Upload Resume
POST http://localhost:5000/api/v1/upload/resume
Content-Type: multipart/form-data

### Recruiter APIs

#### Create Job Posting
POST http://localhost:5000/api/v1/job
Authorization: Bearer RECRUITER_ACCESS_TOKEN
Content-Type: application/json

{
  "title": "Python Developer",
  "skills": ["65f0a8b3e4b0f1a2d4c9a3d3", "65f0a8b3e4b0f1a2d4c9a3d4"],
  "salary_range": "$2000 - $2500",
  "reasons_to_join": "<ul><li>Great work environment</li><li>Opportunities for promotion</li><li>Attractive salary and benefits</li></ul>",
  "required_experience": "<p>Minimum requirement: <strong>2 years of Python experience</strong></p>",
  "responsibility": "<p>Develop backend APIs using Django</p>",
  "description": "<p>Our company is looking for a backend Python developer...</p>"
}

#### Update Job Posting
PUT http://localhost:5000/api/v1/job/JOB_ID_HERE
Authorization: Bearer RECRUITER_ACCESS_TOKEN
Content-Type: application/json

{
  "title": "Backend Developer",
  "skills": ["65e0f6c83c8c3e12a4dfe228", "65e0f6f13c8c3e12a4dfe229"]
}

#### Delete Job Posting
DELETE http://localhost:5000/api/v1/job/JOB_ID_HERE
Authorization: Bearer RECRUITER_ACCESS_TOKEN

#### Get Applicants for a Job
GET http://localhost:5000/api/v1/application/job/job_id
Authorization: Bearer RECRUITER_ACCESS_TOKEN

### Company Management

#### Update Company Information
PUT http://localhost:5000/api/v1/company
Authorization: Bearer RECRUITER_ACCESS_TOKEN

{
  "name": "ABC Technology Ltd.",
  "industry_id": "67d28aceb386d0abcfe72960",
  "locations": [
      {
        "city": "Ha Noi",
        "detailed_location": "Tầng 3 - Dolphin Plaza, 28 Trần Bình"
      },
      {
        "city": "Da Nang",
        "detailed_location": "344 Street 2/9, Hai Chau"
      }
  ],
  "description": "Specializing in software development and AI",
  "website": "https://abc-tech.com",
  "logo": "https://example.com/logo.png",
  "background_image": "https://example.com/bg.jpg",
  "size": "50-100",
  "founded_year": 2020,
  "social_links": {
    "linkedin": "https://linkedin.com/company/abc-tech",
    "facebook": "https://facebook.com/abc-tech"
  }
}
